# Android TWA (twa/) — build outputs and signing material. The keystore and its
# passwords must never be committed; losing the keystore means losing the ability
# to update the app on the Play Store. Build outputs land in twa/ root and are
# regenerated by twa/build.sh.
twa/.gradle/
twa/build/
twa/app/build/
twa/local.properties
twa/android-keystore
twa/keystore.properties
twa/app-release-*.apk
twa/app-release-*.aab
twa/*.idsig
