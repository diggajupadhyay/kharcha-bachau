# Firebase web config. These are public by design in a client-side app — security is
# enforced by the Firestore rules in firestorerules.txt, not by keeping these secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Firebase Analytics measurement ID.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional. Endpoint receiving a JSON POST when the app crashes in production.
# See components/ErrorBoundary.tsx. The host must also be added to connect-src in
# firebase.json, or the Content-Security-Policy will block the request.
VITE_ERROR_REPORT_URL=

# --- React Native / Expo -------------------------------------------------------
# The Android app reads google-services.json from inside the APK, so it needs none
# of these. A WEB build has no such file and must be told the Firebase config from
# JavaScript, which is what EXPO_PUBLIC_* are for. Unset, the web build still runs
# — it simply stays in guest mode with no cloud sync.
#
# Every value here is public by design. The Firestore rules, not these keys, are
# the security boundary.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
